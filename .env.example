# Public site URL used for canonical links, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional: enable analytics integration point (no tracker loaded by default)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Contact delivery — choose one approach
FORMSPREE_FORM_ID=
CONTACT_WEBHOOK_URL=

# Optional Resend integration (wire up in app/api/contact/route.ts when ready)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
